# Never commit .env.local. Put secrets here only in local/deployment secret storage.
OPENAI_API_KEY=
GITHUB_TOKEN=
GITHUB_OWNER=ValerGa0
GITHUB_REPO=valerio-ai-dashboard
PORT=8787

# Supabase browser client (publishable key only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-side Vercel AI Gateway model selection
AI_GATEWAY_MODEL=openai/gpt-5.4-mini
# For local development outside Vercel OIDC, enter your key locally in .env.local
# AI_GATEWAY_API_KEY=
